rules_version = '2';

// ─────────────────────────────────────────────────────────────────
// Firestore security rules
// ─────────────────────────────────────────────────────────────────
// These run on Google's servers, not in the browser, so they are what
// actually protects the data — the interface merely reflects them.
//
// The rule that matters most: a person may create and read their own
// profile, but may never write their own role. Staff is granted from
// outside the app (console or an admin acting server-side), so nobody
// can promote themselves into the prices.
// ─────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff';
    }

    // ── Profiles ────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isOwner(uid) || isStaff();

      // A new account may only create itself, and only as trade.
      allow create: if isOwner(uid)
        && request.resource.data.role == 'trade';

      // Details are the owner's to change; the role is not.
      allow update: if isOwner(uid)
        && request.resource.data.role == resource.data.role;

      allow delete: if false;
    }

    // ── Saved projects ──────────────────────────────────────────
    // A project belongs to whoever created it. Staff can read them so
    // sales can pick up an enquiry, but cannot quietly rewrite one.
    match /projects/{projectId} {
      allow read: if isOwner(resource.data.ownerId) || isStaff();
      allow create: if isOwner(request.resource.data.ownerId);
      allow update: if isOwner(resource.data.ownerId)
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isOwner(resource.data.ownerId);
    }

    // Anything not named above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
