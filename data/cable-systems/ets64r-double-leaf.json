        { "id": "comp-5-2", "position": "5.2", "label": "Sensor strips set (passive leaf)", "type": "sensor_strip", "mandatory": true, "cable": { "defaultCable": "Cables supplied with operator", "allowedCables": ["Cables supplied with operator"], "allowOther": true }, "remarks": "Concealed cable laying in building" }
